	<classpathentry exported="true" kind="lib" path="lib/LatencyUtils-2.0.3.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/hibernate-validator-9.1.0.Final.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/jboss-logging-3.6.1.Final.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/picocli-3.5.1.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/javax.annotation-api-1.3.1.jar"/>
	<classpathentry kind="src" output="target/classes" path="src">
		<attributes>
			<attribute name="optional" value="true"/>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="output" path="target/classes"/>
</classpath>
