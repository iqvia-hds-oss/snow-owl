Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Test Dependencies
Bundle-SymbolicName: com.b2international.snowowl.test.dependencies;singleton:=true
Bundle-Version: 10.2.0
Bundle-Vendor: B2iHealthcare
Bundle-RequiredExecutionEnvironment: JavaSE-25
Bundle-ClassPath: .,
 lib/annotations-17.0.0.jar,
 lib/docker-java-api-3.7.1.jar,
 lib/docker-java-transport-3.7.1.jar,
 lib/docker-java-transport-zerodep-3.7.1.jar,
 lib/duct-tape-1.0.8.jar,
 lib/system-rules-1.19.0.jar,
 lib/testcontainers-2.0.5.jar,
 lib/testcontainers-elasticsearch-2.0.5.jar
Export-Package: com.b2international.snowowl.rules,
 com.github.dockerjava.api.command,
 com.github.dockerjava.api.model,
 org.junit.contrib.java.lang.system,
 org.testcontainers,
 org.testcontainers.containers,
 org.testcontainers.containers.output,
 org.testcontainers.containers.startupcheck,
 org.testcontainers.containers.wait.strategy,
 org.testcontainers.dockerclient,
 org.testcontainers.elasticsearch,
 org.testcontainers.images,
 org.testcontainers.images.builder,
 org.testcontainers.images.builder.dockerfile,
 org.testcontainers.images.builder.dockerfile.statement,
 org.testcontainers.images.builder.dockerfile.traits,
 org.testcontainers.images.builder.traits,
 org.testcontainers.lifecycle,
 org.testcontainers.utility
Require-Bundle: org.junit;bundle-version="4.11.0",
 com.fasterxml.jackson.core.jackson-annotations;bundle-version="2.18.4",
 org.apache.commons.commons-compress;bundle-version="1.26.0",
 org.apache.commons.commons-io;bundle-version="2.18.0",
 org.apache.commons.lang3;bundle-version="3.18.0";visibility:=reexport,
 com.sun.jna;bundle-version="5.18.1",
 com.sun.jna.platform;bundle-version="5.18.1"
Bundle-ActivationPolicy: lazy
Import-Package: org.slf4j;version="2.0.0"
