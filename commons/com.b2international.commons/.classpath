<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER">
		<attributes>
			<attribute name="maven.pomderived" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="org.eclipse.pde.core.requiredPlugins"/>
	<classpathentry exported="true" kind="lib" path="lib/zjsonpatch-0.4.16.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/micrometer-observation-1.15.12.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/micrometer-commons-1.15.12.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/micrometer-core-1.15.12.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/micrometer-registry-prometheus-1.15.12.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/prometheus-metrics-config-1.3.10.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/prometheus-metrics-core-1.3.10.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/prometheus-metrics-model-1.3.10.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/prometheus-metrics-tracer-common-1.3.10.jar"/>
	<classpathentry exported="true" kind="lib" path="lib/prometheus-metrics-exposition-formats-1.3.10.jar"/>
