<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<artifactId>com.b2international.snowowl.snomed.cis.product</artifactId>
	<packaging>eclipse-repository</packaging>

	<parent>
		<groupId>com.b2international.snowowl</groupId>
		<artifactId>cis-parent</artifactId>
		<version>10.4.0</version>
	</parent>
	
	<properties>
		<build.qualifier>${forceContextQualifier}</build.qualifier>
		<build.version>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}.${build.qualifier}</build.version>
		<products.directory>${project.build.directory}/products</products.directory>
		<product.id>com.b2international.snowowl.snomed.cis.product</product.id>
		<so.products.directory>${products.directory}/${product.id}</so.products.directory>
		<linux.product.path>${so.products.directory}/linux/gtk/x86_64/${project.build.finalName}</linux.product.path>
	</properties>
	
	<build>
		<finalName>snow-owl-cis-${build.version}</finalName>
		<plugins>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>parse-version</id>
						<goals>
							<goal>parse-version</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<executions>
					<execution>
						<id>materialize-products</id>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<products>
						<product>
							<id>${product.id}</id>
							<rootFolder>${project.build.finalName}</rootFolder>
						</product>
					</products>
				</configuration>
			</plugin>
			<!-- add blocked certificates to the materialized result -->
			<plugin>
    			<groupId>org.apache.maven.plugins</groupId>
    			<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>patch-blocked-certs</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			    <configuration>
        			<target>
						<!-- define a macro for the operation with a single attribute -->
						<macrodef name="patch-blocked-certs">
							<attribute name="id"/>
							<attribute name="product.root"/>

							<sequential>
								<local name="blocked.certs.count"/>
								<local name="blocked.certs.file"/>
								<local name="blocked.certs.contents"/>
							
								<fileset
									id="blocked.certs.files.@{id}"
									dir="@{product.root}"
									erroronmissingdir="true">
									<include name="**/jre/lib/security/blocked.certs"/>
								</fileset>

								<resourcecount
									property="blocked.certs.count"
									refid="blocked.certs.files.@{id}"/>

								<fail message="Expected exactly one blocked.certs file, but found ${blocked.certs.count}.">
									<condition>
										<not>
											<equals
												arg1="${blocked.certs.count}"
												arg2="1"/>
										</not>
									</condition>
								</fail>

								<!-- convert the single match into a path -->
								<pathconvert
									property="blocked.certs.file"
									refid="blocked.certs.files"/>

								<echo
									file="${blocked.certs.file}"
									append="true"><![CDATA[
42C4ACCD12C4F59597925E1A08A7A90102608543809308D50EC427E118BA1493
45A883F349AEDFD5F3A649B5498FFB121712BA8B448F3F2A91DBC5A766FCDDBE
98B896625C0C230ADEEC3EB2CF6AAD5001ECF9156A68644E82374CE5833BC25B
5F1DED4DD590AF74631290CF073B122A2AAC6A1FA479778A0BD43579BD832699
E7568FE6E12331F4FD7DE61DA4C7559D0F8EB192A218D4741A3BA75184333838
579480AEA166290BD3C643589E795FC0D0E54E86505D180F1DFF99EFD3199512
0164D7CEAE5BB909C272AF151FF44B1177AE9B47D9424B94F1D9558C30934D19
62B7F9868263F72F6911FC78CEAF72C1979158B7368BF648683BB2AA39B02E72
CB6E15165AC802E9B3F993F16C25D41F4E81C21EBDE71AE1B012AC00BF9C7C3F
7485B51C0ED192878FA1D2F948FB529AE1842CC5086C4B67F7BE5B2039DE9489
432EC25F0D28DE9006D97BF752F17BBB2CD41F669933FCB072D9A1148D0261F3
FD9D5C2DBBD4995AB69B8D50C439D9527B00529199C2FD01B2174EB58F07021F
9E39DE2881273ACC225A149C72BA3E0F51424963669AB633EE1DC7DF5DB067B4
A496E23AC0CAB8155FC9B117B97EAE368EFCBB9041AEC8804D5A308D2D01C2D8
4B2460A466F95FD40113BCDCCA2CEB29B3B093921DE45474DA7DF48874C630B1
84112972B8E59D14560AE7E7119654474AAD119990CF3722BFC1E3B91615E1FD
]]></echo>

								<!-- show what the file looks like after modifying it -->
								<loadfile
								    property="blocked.certs.contents"
								    srcFile="${blocked.certs.file}"/>
							
								<echo message="Patched ${blocked.certs.file}:"/>
								<echo message="${blocked.certs.contents}"/>
						    </sequential>
						</macrodef>

						<!-- call the macro once for each product -->
						<patch-blocked-certs id="linux" product.root="${linux.product.path}"/>
        			</target>
				</configuration>
			</plugin>			
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
				<configuration>
					<finalName>${project.build.finalName}-site</finalName>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
				<executions>
					<execution>
						<id>package-cis</id>
						<phase>package</phase>
						<goals>
							<goal>single</goal>
						</goals>
						<configuration>
							<workDirectory>${project.build.directory}/assembly</workDirectory>
							<descriptors>
								<descriptor>${basedir}/assembly/cis.xml</descriptor>
							</descriptors>
							<tarLongFileMode>gnu</tarLongFileMode>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>m2e</id>
			<!-- This profile is only activated when building in Eclipse with m2e -->
			<activation>
				<property>
					<name>m2e.version</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-resources-plugin</artifactId>
						<executions>
							<execution>
								<id>copy-runtime-config</id>
								<phase>process-classes</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<resources>
										<resource>
											<directory>assembly/common</directory>
											<excludes>
												<exclude>bin/**</exclude>
											</excludes>
										</resource>
									</resources>
									<outputDirectory>${basedir}/runtime</outputDirectory>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
